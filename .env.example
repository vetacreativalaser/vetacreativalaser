# ====================================
# VETA CREATIVA LÁSER - Environment Variables
# ====================================
# Copiar este archivo a .env y rellenar con tus valores reales

# ====================================
# SUPABASE
# ====================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ====================================
# STRIPE
# ====================================
# Clave pública de Stripe (frontend)
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_aqui

# Nota: La clave secreta (STRIPE_SECRET_KEY) se configura
# en Supabase Edge Functions usando `supabase secrets set`
